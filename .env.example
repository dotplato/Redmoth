# --- Database (Postgres) ---
# Local: matches docker-compose.yml (the app container overrides the host to `db`).
# Production: pooled URL in DATABASE_URL, direct (non-pooled) URL in DIRECT_URL.
DATABASE_URL="postgresql://redmoth:redmoth@localhost:5432/redmoth"
DIRECT_URL="postgresql://redmoth:redmoth@localhost:5432/redmoth"

# --- Cloudflare R2 (uploads) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="redmoth"
# Public bucket URL (custom domain or https://pub-xxxx.r2.dev), no trailing slash.
R2_PUBLIC_URL="https://cdn.example.com"

# --- Auth (Better Auth) ---
# Signs sessions and email links. Changing it signs everyone out.
AUTH_SECRET="replace-with-a-long-random-string"
# Used by `npm run db:create-admin` and the seed.
ADMIN_EMAIL="admin@redmoth.local"
ADMIN_PASSWORD="change-me"

# --- Domains ---
# Production: e.g. ADMIN_HOST="admin.redmoth.com", PUBLIC_SITE_URL="https://redmoth.com"
ADMIN_HOST="admin.localhost:3000"
PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="redmoth"

# --- AI ---
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# --- Email (Resend) ---
# Needed for signup verification and password reset. Without a verified domain, use
# EMAIL_FROM="onboarding@resend.dev": Resend then only delivers to your own account's address.
# Locally, if these are empty, verification/reset links are printed in the dev server log.
RESEND_API_KEY=""
EMAIL_FROM=""
